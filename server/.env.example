# Copy to .env and edit.  Every setting is optional.

# Listen address of the container. 127.0.0.1 = only through nginx (recommended); 0.0.0.0 = open port 8000
NOTNEGAR_BIND=127.0.0.1

# Address users see (used in email links), e.g. https://notnegar.example.com
NOTNEGAR_PUBLIC_URL=

# Private server: ask for a username and password in the browser (user:password)
NOTNEGAR_BASIC_AUTH=

# Limits
NOTNEGAR_MAX_UPLOAD_MB=80
NOTNEGAR_MAX_SECONDS=600
NOTNEGAR_MAX_QUEUE=20
NOTNEGAR_TTL_HOURS=72
# songs processed at the same time (each needs about 3-4 GB of RAM)
NOTNEGAR_WORKERS=1

# Models
NOTNEGAR_DEMUCS_MODEL=htdemucs_6s
# full = most accurate; tiny = much faster on a weak CPU
NOTNEGAR_CREPE_MODEL=full
# CPU threads for PyTorch (0 = all cores)
NOTNEGAR_TORCH_THREADS=0
# auto | cpu | cuda
NOTNEGAR_DEVICE=auto

# Email (leave NOTNEGAR_SMTP_HOST empty to disable)
NOTNEGAR_SMTP_HOST=
NOTNEGAR_SMTP_PORT=587
NOTNEGAR_SMTP_SECURITY=starttls
NOTNEGAR_SMTP_USER=
NOTNEGAR_SMTP_PASSWORD=
NOTNEGAR_SMTP_FROM=
